# jumboo-agent-example configuration
# Copy to .env and fill in. The .env file is gitignored — never commit keys.

# HTTP port the agent backend listens on.
PORT=8917

# Ethereum JSON-RPC endpoint (local hardhat node or Sepolia).
RPC_URL=http://127.0.0.1:8545

# On-chain agent NFT id in JumbooIdentityRegistry (this backend serves ONE agent).
AGENT_ID=1

# Private key of the agent's REGISTERED hot wallet (agentWallets(AGENT_ID)).
# Signs the raw taskId bytes for the PR marker block — the oracle recovers this
# exact wallet from Jumboo-Signature. Test-only hardhat keys are fine locally.
AGENT_HOT_KEY=

# Optional separate wallet that pays gas for submitValidation (the claim tx).
# Falls back to AGENT_HOT_KEY when empty.
AGENT_TX_KEY=

# GitHub personal access token of the agent's machine user. Used to clone
# private/authenticated repos, fetch issue bodies, fork, and open PRs.
# May be left empty for DRY_RUN testing against local file:// remotes.
GITHUB_TOKEN=

# GitHub username of the machine user (commit author + fork owner + PR head).
GITHUB_USERNAME=

# Jumboo oracle base URL — polled at /attestations/<taskId>/<agentId>.
ORACLE_URL=http://localhost:8787

# Deployed contract addresses.
TASK_REGISTRY_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
VALIDATION_REGISTRY_ADDRESS=

# Directory where task repos are cloned (one subdir per job). Gitignored.
WORKDIR=./workspace

# Solver driver: "claude-cli" (spawns the Claude Code CLI headless — must be
# installed & authenticated on this host) or "echo" (no AI; writes SOLUTION.md,
# for pipeline testing).
SOLVER=claude-cli

# Authoritative x402 hire price quoted in the 402 response for POST /solve.
# The `pricing` field in the agent's ERC-8004 metadata is advisory only.
HIRE_PRICE_AMOUNT=0.50
HIRE_PRICE_ASSET=USDC
HIRE_PRICE_NETWORK=sepolia

# DRY_RUN=1: run clone → solve → commit → push, but SKIP PR creation and
# attestation polling; the PR marker block is logged instead. Use for local
# testing against file:// remotes.
DRY_RUN=0

# Seconds between oracle attestation polls while a PR awaits a human merge.
ATTESTATION_POLL_SEC=60
